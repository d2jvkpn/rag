# syntax=docker/dockerfile:1.7

FROM node:24-alpine AS frontend-deps
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM frontend-deps AS frontend-build
COPY frontend/ ./
RUN make build

FROM golang:1.25-alpine AS backend-deps
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download

FROM backend-deps AS backend-build
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server

FROM alpine:3.22 AS runtime
WORKDIR /app

RUN addgroup -g 1000 appuser \
    && adduser -D -H -u 1000 -G appuser -h /app -s /sbin/nologin appuser \
    && mkdir -p /app/configs /app/data /app/logs /app/target/ui \
    && chown -R 1000:1000 /app

COPY --from=backend-build /out/server /app/server
COPY --from=frontend-build /src/frontend/target/dist/ /app/target/ui/
COPY backend/examples/local.yaml /app/configs/local.yaml

RUN chown -R 1000:1000 /app

USER 1000:1000
EXPOSE 3061

ENTRYPOINT ["/app/server"]
CMD ["--release", "--config", "/app/configs/local.yaml", "--addr", ":3061"]
